{
  "name": "@voxelkloud/view",
  "version": "0.8.0",
  "description": "WebGPU point cloud renderer built on three.js (WebGPURenderer/TSL), consuming @voxelkloud/loader streams.",
  "license": "MIT",
  "keywords": [
    "point-cloud",
    "potree",
    "lidar",
    "webgpu",
    "three",
    "threejs",
    "renderer",
    "viewer",
    "lod"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voxelkloud/view.git"
  },
  "homepage": "https://github.com/voxelkloud/voxelkloud",
  "bugs": {
    "url": "https://github.com/voxelkloud/voxelkloud/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lod": {
      "types": "./dist/lod/index.d.ts",
      "import": "./dist/lod/index.js"
    },
    "./profile": {
      "types": "./dist/profile/index.d.ts",
      "import": "./dist/profile/index.js"
    },
    "./material": {
      "types": "./dist/material-entry.d.ts",
      "import": "./dist/material-entry.js"
    },
    "./edl": {
      "types": "./dist/edl-entry.d.ts",
      "import": "./dist/edl-entry.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@voxelkloud/core": "^0.5.0",
    "@voxelkloud/loader": "^0.5.0",
    "@voxelkloud/format-potree": "^0.5.0"
  },
  "peerDependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "@webgpu/types": "^0.1.72",
    "three": "^0.180.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "peerDependenciesMeta": {
    "@types/three": {
      "optional": true
    }
  }
}
